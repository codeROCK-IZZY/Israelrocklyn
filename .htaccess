# israelrocklyn.info: Apache configuration (20i Linux hosting)

Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical address: HTTPS, no "www".
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
  RewriteRule ^ https://israelrocklyn.info%{REQUEST_URI} [R=301,L]

  # Internal files are never served: application code, tests, docs, repository metadata.
  RewriteRule ^(app|tests|\.github|\.git)(/|$) - [R=404,L]
  RewriteRule ^(README\.md|LICENSE|router\.php|contact-config.*|\.gitignore|\.gitattributes)$ - [R=404,L]

  # Clean URLs.
  RewriteRule ^work/([a-z0-9-]+)/?$ work.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^index\.php$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always unset X-Powered-By

  # Versioned assets (?v=) and fonts are safe to cache for a year.
  <FilesMatch "\.(css|js|woff2|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
